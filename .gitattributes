# 统一换行，避免 Windows 提交把整个仓库变成 CRLF 噪声
* text=auto eol=lf

# 脚本保持各自的换行约定
gradlew        text eol=lf
*.sh           text eol=lf
*.bat          text eol=crlf
*.cmd          text eol=crlf

# 二进制：不做 diff / 换行转换
*.png          binary
*.webp         binary
*.jpg          binary
*.jpeg         binary
*.jar          binary
*.apk          binary
*.jks          binary
*.keystore     binary
